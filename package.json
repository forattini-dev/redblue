{
  "name": "redblue-cli",
  "version": "0.2.16",
  "description": "JavaScript SDK wrapper for the redblue CLI",
  "type": "commonjs",
  "main": "./sdk/redblue-sdk.js",
  "types": "./sdk/index.d.ts",
  "bin": {
    "rb": "./sdk/redblue-sdk.js",
    "redblue-cli": "./sdk/redblue-sdk.js"
  },
  "exports": {
    ".": {
      "require": "./sdk/redblue-sdk.js",
      "types": "./sdk/index.d.ts",
      "default": "./sdk/redblue-sdk.js"
    }
  },
  "files": [
    "sdk/redblue-sdk.js",
    "sdk/postinstall.js",
    "sdk/index.d.ts",
    "sdk/generated-routes.d.ts",
    "sdk/generated-routes.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forattini-dev/redblue.git"
  },
  "bugs": {
    "url": "https://github.com/forattini-dev/redblue/issues"
  },
  "homepage": "https://github.com/forattini-dev/redblue",
  "keywords": [
    "redblue",
    "security",
    "cli",
    "sdk",
    "dns",
    "tls",
    "ports"
  ],
  "license": "MIT",
  "dependencies": {},
  "scripts": {
    "version": "node scripts/sync-from-pkg.js",
    "version:sync": "node scripts/sync-version.js",
    "sdk:generate": "node scripts/generate-sdk-surface.js",
    "sdk:check": "node scripts/generate-sdk-surface.js --check",
    "postinstall": "node sdk/postinstall.js",
    "build": "node --check sdk/redblue-sdk.js",
    "test": "node --test --test-reporter=spec sdk/test/*.test.js",
    "coverage": "node scripts/check-sdk-coverage.js",
    "pack-check": "pnpm pack",
    "prepublishOnly": "pnpm run version:sync && pnpm run build && pnpm run coverage && pnpm run pack-check",
    "publish:npm": "pnpm publish --provenance --no-git-checks",
    "publish:npm:next": "pnpm publish --tag next --provenance --no-git-checks"
  }
}
